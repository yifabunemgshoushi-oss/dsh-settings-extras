{
  "name": "dsh-settings-extras",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "在 dsh「设置 → 通用设置」中增加自动压缩阈值与默认思考等级两项",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "license": "MIT"
}
